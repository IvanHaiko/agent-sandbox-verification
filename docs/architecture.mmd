  A["accept()<br/>scope, frozen hashes, exit codes, review"]
  O["Probe oracles<br/>inotify on canaries, tokens,<br/>byte hashes, negative control"]
  P --> E
  E --> C
  E --> F
  C -->|read inputs, write tests/| WS
  F -->|read inputs, write tests/| WS
  C -. denied .-> X
  F -. denied .-> X
