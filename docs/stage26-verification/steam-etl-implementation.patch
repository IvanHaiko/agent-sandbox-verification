+
+
+def test_missing_appid_and_unknown_outcome(monkeypatch):
+    payload = envelope("redirected", body=[1])
+    del payload["appid"]
+    assert run_file(monkeypatch, payload) == "redirected"
+    with pytest.raises(ValueError, match="does not accept"):
