+    assert run_file(monkeypatch, payload) == "not_found"
+    assert stored_rows() == [(100, "requested", "not_found", None, 1, 0)]
+    assert run_file(monkeypatch, payload) == "not_found"
+    assert stored_rows() == [(100, "requested", "not_found", None, 1, 0)]
