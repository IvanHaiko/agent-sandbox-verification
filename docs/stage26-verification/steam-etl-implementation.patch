+
+
+def test_redirect_database_identity_and_replay(test_database, monkeypatch):
+    seed_requested()
+    payload = envelope("redirected")
+    assert run_file(monkeypatch, payload) == "redirected"
+    first = stored_rows()
+    assert first == [
+        (80, "target", "ok", None, 1, 0),
+        (100, "requested", "redirected", 90, 1, 0),
