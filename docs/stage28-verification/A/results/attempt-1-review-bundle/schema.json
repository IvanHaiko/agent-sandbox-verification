{
  "type": "object",
  "properties": {
    "recommendation": {
      "type": "string",
      "enum": [
        "accept",
        "reject",
        "request-fix"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2500
      },
      "maxItems": 6
    },
    "findings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "criterion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "nonblocking",
              "info"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "already_established_by_acceptance": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "criterion",
          "severity",
          "description",
          "evidence",
          "already_established_by_acceptance"
        ],
        "additionalProperties": false
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2500
    }
  },
  "required": [
    "recommendation",
    "blockers",
    "findings",
    "rationale"
  ],
  "additionalProperties": false
}
